[Unit]
Description=ResultBot Excellent earnings listener and owner-controlled Equity AMO
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/uditbot
ExecStart=%h/uditbot/venv/bin/python %h/resultbot-data/excellent_watch.py listen
Restart=on-failure
RestartSec=20
Environment=PYTHONUNBUFFERED=1
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
