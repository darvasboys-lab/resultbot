#!/usr/bin/env bash
# RESULTBOT_REGULAR_ENTRY_COMMANDS_V1
case "${1:-}" in
  live-on|live-off|amo-off|stop)
    action="$1"
    [[ "$action" == stop ]] && action=stop-all
    exec "$HOME/uditbot/venv/bin/python" "$HOME/resultbot-data/equity_amo_live.py" "$action"
    ;;
esac
set -uo pipefail

D="$HOME/resultbot-data"
PY="$HOME/uditbot/venv/bin/python"

help_menu() {
  echo
  echo "============================================"
  echo "          RESULTBOT COMMAND CENTER"
  echo "============================================"
  echo " bot status  - Colorized read-only health dashboard"
  echo " bot setup   - Edit settings and YES/NO"
  echo " bot orders  - View real AMO orders"
  echo " bot funds   - Check live Dhan balance"
  echo " bot menu    - Numbered command menu"
  echo " bot logs    - Live earnings/AMO logs"
  echo " bot help    - Show this menu"
  echo "============================================"
  echo
}

case "${1:-help}" in
  status|sttaus)
    exec "$PY" "$HOME/.local/share/resultbot/status_dashboard.py"
    ;;

  setup)
    exec bash "$D/amo_settings.sh"
    ;;

  orders)
    exec "$PY" "$D/equity_amo_live.py" status
    ;;

  funds)
    exec "$PY" "$D/dhan_readonly.py" funds
    ;;

  menu)
    source "$HOME/.local/share/resultbot/menu.sh"
    menu
    ;;
  logs|livelogs|prevlogs|daylogs)
    source "$HOME/.local/share/resultbot/menu.sh"
    case "$1" in
      logs|livelogs) livelogs ;;
      prevlogs) prevlogs ;;
      daylogs) daylogs ;;
    esac
    ;;
  help|-h|--help)
    help_menu
    ;;

  *)
    echo "Unknown command: $1"
    help_menu
    exit 1
    ;;
esac
