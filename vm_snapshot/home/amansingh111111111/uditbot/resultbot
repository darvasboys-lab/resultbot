#!/usr/bin/env bash
# =====================================================================
# PLATINUM / UDITBOT UNIFIED OPERATOR CLI ('bot')
# V12-22 & V14 VM Rebuild Fix: Resolves symlinks (e.g. /usr/local/bin/bot),
# changes into the application root directory, and exposes read-only VM audit,
# encrypted runtime backup/restore, and session export helpers.
# =====================================================================
set -e

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    LINK_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$LINK_DIR/$SOURCE"
done
DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
cd "$DIR"

PYTHON="${DIR}/venv/bin/python3"
if [ ! -f "$PYTHON" ]; then
    PYTHON="python3"
fi

export PYTHONPATH="${DIR}:${PYTHONPATH:-}"

case "${1:-}" in
    status)
        "$PYTHON" -m src.cli status
        ;;
    dashboard|dash)
        "$PYTHON" -m src.cli dashboard
        ;;
    check-dhan|test-dhan|dhan)
        "$PYTHON" -m src.cli check-dhan
        ;;
    login|refresh-token|token|totp)
        "$PYTHON" -m src.cli login
        ;;
    daily_health_check|daily-health-check|health-check)
        "$PYTHON" -m src.cli daily_health_check
        ;;
    mode)
        "$PYTHON" -m src.cli mode
        ;;
    setup)
        "$PYTHON" -m src.setup_wizard
        ;;
    web)
        shift || true
        "$PYTHON" -m src.cli web "$@"
        ;;
    journal|logs)
        shift || true
        "$PYTHON" -m src.cli journal "$@"
        ;;
    test-signal|test_signal)
        shift || true
        "$PYTHON" -m src.cli test-signal "$@"
        ;;
    rules|rule)
        shift || true
        "$PYTHON" -m src.cli rules "$@"
        ;;
    emergency-stop|stop-trading)
        shift || true
        "$PYTHON" -m src.cli emergency-stop "$@"
        ;;
    resume|start-trading)
        shift || true
        "$PYTHON" -m src.cli resume "$@"
        ;;
    audit|audit-vm)
        bash "${DIR}/deploy/audit_vm_state.sh"
        ;;
    backup|backup-runtime)
        shift || true
        bash "${DIR}/deploy/backup_runtime.sh" "$@"
        ;;
    restore|restore-runtime)
        shift || true
        bash "${DIR}/deploy/restore_runtime.sh" "$@"
        ;;
    install-services)
        shift || true
        bash "${DIR}/deploy/install_vm_services.sh" "${@:---plan}"
        ;;
    export-session)
        "$PYTHON" -m src.tg_login --export-string
        ;;
    start)
        shift || true
        "$PYTHON" -m src.cli service-start "$@"
        ;;
    stop)
        shift || true
        "$PYTHON" -m src.cli service-stop "$@"
        ;;
    restart)
        shift || true
        "$PYTHON" -m src.cli service-restart "$@"
        ;;
    service-logs)
        sudo journalctl -u trading_bot.service -f
        ;;
    web-status)
        systemctl status auditbot-web.service --no-pager
        ;;
    web-restart)
        sudo systemctl restart auditbot-web.service
        echo "auditbot-web service restarted."
        ;;
    web-logs)
        sudo journalctl -u auditbot-web.service -f
        ;;
    live)
        echo "⚠️  SWITCHING TRADING_MODE TO LIVE"
        read -p "Are you sure you want to enable LIVE broker order placement? (yes/no): " ans
        if [ "$ans" = "yes" ]; then
            if [ -f "${DIR}/.env" ]; then
                sed -i 's/^TRADING_MODE=.*/TRADING_MODE=LIVE/' "${DIR}/.env"
                echo "TRADING_MODE set to LIVE in .env."
                if systemctl is-active --quiet trading_bot.service; then
                    sudo systemctl restart trading_bot.service
                    echo "Service restarted in LIVE mode."
                fi
            else
                echo "Error: .env not found. Run 'bot setup' first."
            fi
        else
            echo "Cancelled. Still in current mode."
        fi
        ;;
    test)
        if [ -f "${DIR}/.env" ]; then
            sed -i 's/^TRADING_MODE=.*/TRADING_MODE=TEST/' "${DIR}/.env"
            echo "TRADING_MODE set to TEST in .env."
            if systemctl is-active --quiet trading_bot.service; then
                sudo systemctl restart trading_bot.service
                echo "Service restarted in TEST mode."
            fi
        fi
        ;;
    help|--help|-h|*)
        echo "======================================================="
        echo "      RESULTBOT OPERATOR CONTROL CLI         "
        echo "======================================================="
        echo "Usage: resultbot <command>"
        echo ""
        echo "Operational Commands:"
        echo "  resultbot status              Check running status, mode, and parameters"
        echo "  resultbot dashboard           Live read-only SSH terminal dashboard"
        echo "  resultbot check-dhan          Diagnose Dhan API connection, funds, LTP, and execution readiness"
        echo "  resultbot login               Generate fresh 24h Dhan access token using TOTP"
        echo "  resultbot daily_health_check  Run scheduled 08:00 IST token refresh & health probe"
        echo "  resultbot setup               Run interactive terminal setup wizard"
        echo "  resultbot web                 Launch localhost setup web interface (127.0.0.1:8080)"
        echo "  resultbot journal [n]         View last n signal evaluation records"
        echo "  resultbot audit               Read-only VM & systemd drift audit"
        echo "  resultbot backup <out.gpg>    Create encrypted off-VM runtime backup"
        echo "  resultbot restore <in.gpg>    Restore encrypted runtime backup (forces TEST)"
        echo "  resultbot export-session      Export data/tg_userbot.session to TG_SESSION_STRING in .env"
        echo "  resultbot live                Switch master mode to LIVE (requires confirmation)"
        echo "  resultbot test                Switch master mode to TEST"
        echo "  resultbot emergency-stop      Halt all new trade entries immediately"
        echo "  resultbot resume              Resume normal trading operations"
        echo "  resultbot start               Start trading_bot systemd service"
        echo "  resultbot stop                Stop trading_bot systemd service"
        echo "  resultbot restart             Restart trading_bot systemd service"
        echo "  resultbot service-logs        Watch trading_bot systemd service logs live"
        echo "  resultbot web-status          Check auditbot-web systemd service status"
        echo "  resultbot web-restart         Restart auditbot-web systemd service"
        echo "  resultbot web-logs            Watch auditbot-web systemd service logs live"
        echo "======================================================="
        ;;
esac
